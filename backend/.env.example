# Copy this file to ".env" (in the backend folder) and fill in your own values.
# Never commit the real .env file to GitHub.

# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/sanifit

# Any long random string, used to sign login tokens (JWT)
JWT_SECRET_KEY=change_this_to_a_long_random_secret

# development shows detailed error messages, production hides them
NODE_ENV=development

# Backend port (the frontend proxy expects 5000)
PORT=5000
